generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Image {
  id           String   @id @default(uuid())
  originalName String
  fileName     String
  mimeType     String
  size         Int
  path         String
  url          String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
