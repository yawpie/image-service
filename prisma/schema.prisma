generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model image {
  id           String   @id @default(uuid())
  originalName String
  fileName     String
  mimeType     String
  size         Int
  path         String
  url          String @unique
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model apikey {
  id          String   @id @default(cuid())
  keyHash     String
  serviceName String
  adminId     String?  // TODO: buat relasi ke database utama
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime?
}
